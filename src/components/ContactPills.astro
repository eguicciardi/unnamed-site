---
import { site } from "../data/site";

// Neutral icons rather than the services' trademarks, each paired with a
// visible text label. Each has its own hover animation (see global.css keyframes).
const pills = [
	{
		label: "Email",
		href: `mailto:${site.email}`,
		external: false,
		anim: "bounce",
	},
	{ label: "GitHub", href: site.github, external: true, anim: "spread" },
	{ label: "LinkedIn", href: site.linkedin, external: true, anim: "pop" },
	{ label: "RSS", href: site.rss, external: false, anim: "ping" },
];
---

<div class="pills">
	{
		pills.map(({ label, href, external, anim }) => (
			<a
				{href}
				class="pill"
				target={external ? "_blank" : undefined}
				rel={external ? "noopener" : undefined}
			>
				<svg
					class={`icon ${anim}`}
					width="17"
					height="17"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					{anim === "bounce" && (
						<>
							<rect x="2.5" y="5" width="19" height="14" rx="2.5" />
							<path d="M3.2 6.4 12 13l8.8-6.6" />
						</>
					)}
					{anim === "spread" && (
						<>
							<path d="M9 7.5 4.5 12 9 16.5" />
							<path d="M15 7.5 19.5 12 15 16.5" />
							<path d="M13.2 5.6 10.8 18.4" />
						</>
					)}
					{anim === "pop" && (
						<>
							<rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
							<circle cx="8.6" cy="10" r="1.9" />
							<path d="M5.6 15.8c0-1.7 1.3-2.8 3-2.8s3 1.1 3 2.8" />
							<path d="M14.6 9.6h4.4M14.6 12.6h4.4M14.6 15.6h2.8" />
						</>
					)}
					{anim === "ping" && (
						<>
							<circle
								cx="6.2"
								cy="17.8"
								r="1.7"
								fill="currentColor"
								stroke="none"
							/>
							<path d="M4.5 11.4a8.1 8.1 0 0 1 8.1 8.1" />
							<path d="M4.5 5.6a13.9 13.9 0 0 1 13.9 13.9" />
						</>
					)}
				</svg>
				{label}
				{external && <span class="sr-only">(opens in a new tab)</span>}
			</a>
		))
	}
</div>

<style>
	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 9px 15px 9px 13px;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		letter-spacing: 0.02em;
		color: var(--body);
		transition:
			color 0.22s ease,
			border-color 0.22s ease,
			background 0.22s ease,
			transform 0.22s ease;
	}
	.pill:hover {
		color: var(--pop-text);
		border-color: var(--pop);
		background: var(--row-hover);
		transform: translateY(-2px);
	}

	.icon {
		flex: none;
		overflow: visible;
	}
	.pill:hover .bounce {
		animation: cvBounce 0.7s ease;
	}
	.pill:hover .spread {
		animation: cvSpread 0.65s ease;
	}
	.pill:hover .pop {
		animation: cvPop 0.6s ease;
	}
	.pill:hover .ping {
		animation: cvPing 0.7s ease;
	}
</style>
