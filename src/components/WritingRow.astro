---
interface Props {
	title: string;
	href: string;
	/** Already formatted: `2026.08.14` on the home index, `14 Aug` in the archive. */
	date: string;
	mins: number;
	/** Only the archive passes this; the home index is deliberately dry. */
	excerpt?: string;
	/** Position in the list, used to stagger the entrance. */
	index?: number;
}

const { title, href, date, mins, excerpt, index = 0 } = Astro.props;
const archive = excerpt !== undefined;
---

<a {href} class:list={["row", { archive }]} style={`--i:${index}`}>
	<div class="line">
		<span class="meta date">{date}</span>
		<h3 class="row-title">{title}</h3>
		<span class="meta mins">{mins} min</span>
	</div>
	{excerpt && <p class="excerpt">{excerpt}</p>}
</a>

<style>
	.row {
		padding-block: 13px;
	}
	.row.archive {
		padding-block: 14px;
	}

	.line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 16px;
	}

	.date {
		flex: none;
		width: 11ch;
		font-size: 12px;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}
	.archive .date {
		width: 7ch;
	}

	.row-title {
		flex: 1 1 260px;
		font-size: 20px;
	}
	.archive .row-title {
		flex-basis: 240px;
		font-size: 19px;
	}

	.mins {
		flex: none;
		font-size: 11.5px;
		letter-spacing: 0.04em;
	}

	.excerpt {
		margin-top: 5px;
		padding-left: calc(7ch + 16px);
	}
</style>
