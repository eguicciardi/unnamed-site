---
import { site } from "../../data/site";
import ThemeSwitch from "./ThemeSwitch.astro";

interface Props {
	/** True on the Posts archive, where the nav item is the current page. */
	onPosts?: boolean;
}

const { onPosts = false } = Astro.props;
---

<header class="header">
	<div class="frame bar">
		<a class="brand" href="/">{site.domain}</a>
		<div class="right">
			{
				onPosts ? (
					<span class="nav current" aria-current="page">
						Posts
					</span>
				) : (
					<a class="nav" href="/posts">
						Posts
					</a>
				)
			}
			<ThemeSwitch />
		</div>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		backdrop-filter: blur(10px);
		background: var(--header-bg);
		border-bottom: 1px solid var(--hairline);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-block: 16px;
	}

	.brand {
		font-weight: 700;
		font-size: 18px;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.right {
		display: flex;
		align-items: center;
		gap: clamp(14px, 3vw, 26px);
	}

	.nav {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.04em;
		color: var(--body);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 5px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}
	.nav:hover,
	.current {
		color: var(--ink);
		text-decoration-color: var(--pop);
	}
</style>
