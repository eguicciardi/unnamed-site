---
import "../styles/global.css";
import Head from "../components/layout/Head.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import AmbientLayer from "../components/layout/AmbientLayer.astro";

interface Props {
	title: string;
	description?: string;
	/** Seed and size of the ambient layer; each page gets its own fixed layout. */
	ambient: { seed: number; count: number; maxSize?: number };
	current?: "about" | "posts";
}

const { title, description, ambient, current } = Astro.props;
---

<html lang="en" data-theme="light" data-accent="Blue ink" data-motion="on">
	<head>
		<Head title={title} description={description} />
	</head>
	<body>
		{
			/* `clip`, not `hidden`: hidden would make this a scroll container and break the sticky header. */
		}
		<div id="top" class="page">
			<a class="skip" href="#main">Skip to content</a>
			<AmbientLayer {...ambient} />
			<Header {current} />
			<main id="main" class="frame">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.page {
		min-height: 100vh;
		overflow-x: clip;
	}

	main {
		position: relative;
		z-index: 1;
	}

	/* The ambient glyphs drift behind the page. Every block of content gets
	   the paper colour, so a glyph can pass behind text but never under it:
	   text always sits on a plain background and keeps its contrast. */
	main > :global(*:not(.hairline)) {
		background: var(--bg);
		transition: background 0.4s ease;
	}

	.skip {
		position: absolute;
		z-index: 30;
		top: 8px;
		left: 8px;
		padding: 10px 16px;
		border-radius: 6px;
		background: var(--ink);
		color: var(--bg);
		font-family: var(--font-mono);
		font-size: 13px;
		transform: translateY(-200%);
	}
	.skip:focus {
		transform: none;
	}
</style>
