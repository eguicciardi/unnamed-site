---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContactPills from "../components/ContactPills.astro";
import { site } from "../data/site";

const principles = [
	{
		title: "Failure is the normal case",
		text: "Retries, timeouts and half finished work are designed in from the start, not patched after the first incident.",
	},
	{
		title: "Write the reasoning down",
		text: "A decision is only useful if the next person can see why it was made, and change it safely.",
	},
	{
		title: "Leave it safer than you found it",
		text: "Every change to an old system should make the next one easier and less risky: clearer data flows, tests where it hurts, fewer surprises.",
	},
	{
		title: "Judge it by what users feel",
		text: "Latency, correctness and clear errors matter more than how elegant the diagram looks.",
	},
];
---

<Base
	title="About · Emanuele Guicciardi"
	description="Who I am, what I do and how I work: a senior backend developer in Pisa, Italy, from new systems to legacy maintenance and security."
	ambient={{ seed: 13, count: 14, maxSize: 28 }}
	current="about"
>
	<div class="column">
		<div class="crumbs">
			<Breadcrumb crumbs={[{ label: "Home", href: "/" }, { label: "About" }]} />
		</div>

		<header class="intro">
			<h1>Systems that keep <em>working</em></h1>
			<p class="standfirst">
				I'm Emanuele, a senior backend developer based in Pisa, Italy. I build
				the parts of a product that people rarely see and always depend on.
			</p>
		</header>

		<div class="prose">
			<h2>What I do</h2>
			<p>
				I design and build the backend of products: how the pieces fit together,
				how they talk to each other and how they reach production. That means
				architecture, APIs and the delivery pipeline around them, always aimed
				at products that scale and that people enjoy using.
			</p>
			<p>
				Since {site.current.since} I've been doing this as a{" "}
				{site.current.role.toLowerCase()} at{" "}
				<a href={site.current.employerUrl} target="_blank" rel="noopener"
					>{site.current.employer}<span class="sr-only">
						(opens in a new tab)</span
					></a
				>, in {site.current.location}.
			</p>

			<h2>Legacy systems and security</h2>
			<p>
				A lot of real work happens on software that already exists. I maintain
				legacy applications built around complex data workflows: I map how the
				data really moves, put safety nets around the risky parts, and improve
				the system step by step, without stopping the business that depends on
				it.
			</p>
			<p>
				I also secure them. That means finding and closing weak spots,
				tightening who can access what, and hardening the delivery pipeline, so
				that an old system stops being a liability and becomes something the
				team can change with confidence.
			</p>

			<h2>How I work</h2>
			<ul class="principles">
				{
					principles.map(({ title, text }) => (
						<li>
							<strong>{title}</strong> — {text}
						</li>
					))
				}
			</ul>

			<h2>Tools</h2>
			<p>
				The tools change, the habits don't. These are the ones I reach for most.
			</p>
			<ul class="tools">
				{site.skills.map((skill) => <li>{skill}</li>)}
			</ul>

			<h2>Writing</h2>
			<p>
				I keep notes from my own work and a linkblog of things worth reading. If
				you want to see how I think, that is the best place to start:{" "}
				<a href="/posts">everything I've written and read</a>.
			</p>

			<h2>Get in touch</h2>
			<p>
				If you're building something and think I could help, write to me. I'm
				always happy to talk about well built systems.
			</p>
			<ContactPills />
		</div>
	</div>
</Base>

<style>
	.column {
		max-width: 720px;
		padding-top: clamp(24px, 4vw, 40px);
		padding-bottom: clamp(20px, 4vw, 40px);
	}

	.crumbs {
		margin-bottom: clamp(28px, 5vw, 44px);
	}

	.intro {
		margin-bottom: clamp(32px, 5vw, 48px);
		animation: cvUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
	}

	h1 {
		margin-bottom: 18px;
		font-weight: 700;
		font-size: clamp(32px, 5.4vw, 52px);
		line-height: 1.08;
		letter-spacing: -0.03em;
		text-wrap: pretty;
	}
	h1 em {
		color: var(--pop);
	}

	.standfirst {
		max-width: 56ch;
		font-size: clamp(17px, 2vw, 20px);
		line-height: 1.6;
		color: var(--body);
		text-wrap: pretty;
	}

	.prose {
		animation: cvUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
	}
	.prose h2 {
		margin: 44px 0 18px;
		font-weight: 700;
		font-size: clamp(22px, 3vw, 27px);
		line-height: 1.25;
		letter-spacing: -0.015em;
		color: var(--ink);
	}
	.prose h2:first-child {
		margin-top: 0;
	}
	.prose p {
		margin-bottom: 26px;
		font-family: var(--font-mono);
		font-size: 14.5px;
		line-height: 2.05;
		color: var(--body);
		text-wrap: pretty;
	}
	.prose p a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--hi);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.principles {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin-bottom: 26px;
	}
	.principles li {
		padding: 2px 0 2px 22px;
		border-left: 2px solid var(--hairline);
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.95;
		color: var(--body);
	}
	.principles strong {
		font-weight: 500;
		color: var(--ink);
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 26px;
	}
	.tools li {
		padding: 4px 11px;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.03em;
		color: var(--body);
	}
</style>
