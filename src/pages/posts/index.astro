---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import WritingRow from "../../components/WritingRow.astro";
import LinkRow from "../../components/LinkRow.astro";
import {
	formatDayMonth,
	getLinks,
	getWriting,
	groupByYear,
	readingMinutes,
} from "../../lib/content";

const writing = await getWriting();
const years = groupByYear(writing);
const links = await getLinks();
---

<Base
	title="Posts · Emanuele Guicciardi"
	description="Everything I've written and read: notes from my own work and a linkblog."
	ambient={{ seed: 23, count: 14, maxSize: 28 }}
	onPosts
>
	<div class="column">
		<div class="crumbs">
			<Breadcrumb crumbs={[{ label: "Home", href: "/" }, { label: "Posts" }]} />
		</div>

		<header class="intro">
			<h1>Everything I've <em>written</em> and read</h1>
			<p>
				Two archives on one page: notes from my own work, and the linkblog of
				things worth reading that I keep alongside it.
			</p>
		</header>

		<div class="jumps">
			<a href="#writing">↓ Writing</a>
			<a href="#reading">↓ Reading list</a>
		</div>

		<section id="writing" class="block">
			<div class="section-head">
				<h2 class="section-title">Writing</h2>
				<p class="aside">{writing.length} notes from my own work</p>
			</div>
			<div class="hairline"></div>

			{
				years.map(({ year, items }) => (
					<div class="year">
						<p class="meta year-label">{year}</p>
						<div class="rows">
							{items.map((entry, i) => (
								<WritingRow
									title={entry.data.title}
									href={`/posts/${entry.id}`}
									date={formatDayMonth(entry.data.date)}
									mins={readingMinutes(entry.body)}
									excerpt={entry.data.excerpt}
									index={i}
								/>
							))}
						</div>
					</div>
				))
			}
		</section>

		<section id="reading" class="block reading">
			<div class="section-head">
				<h2 class="section-title">Reading list</h2>
				<p class="aside">elsewhere on the web</p>
			</div>
			<div class="hairline"></div>

			<div class="rows list">
				{
					links.map((link, i) => (
						<LinkRow
							title={link.data.title}
							url={link.data.url}
							author={link.data.author}
							excerpt={link.data.excerpt}
							index={i}
						/>
					))
				}
			</div>
		</section>
	</div>
</Base>

<style>
	.column {
		max-width: 860px;
		padding-top: clamp(24px, 4vw, 40px);
	}

	.crumbs {
		margin-bottom: clamp(26px, 4vw, 38px);
	}

	.intro {
		margin-bottom: clamp(30px, 5vw, 44px);
		animation: cvUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.06s both;
	}
	h1 {
		margin-bottom: 14px;
		font-weight: 700;
		font-size: clamp(34px, 5.6vw, 56px);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	h1 em {
		color: var(--pop);
	}
	.intro p {
		max-width: 56ch;
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.9;
		color: var(--body);
	}

	.jumps {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: clamp(32px, 5vw, 48px);
		animation: cvUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
	}
	.jumps a {
		padding: 8px 15px;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		letter-spacing: 0.03em;
		color: var(--body);
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.jumps a:hover {
		color: var(--pop);
		border-color: var(--pop);
	}

	.block {
		scroll-margin-top: 80px;
	}
	.reading {
		padding-top: clamp(30px, 5vw, 48px);
	}

	/* Archive headings are a step smaller than on the home page. */
	.section-title {
		font-size: clamp(22px, 3vw, 30px);
	}
	.section-head {
		margin-bottom: 10px;
	}
	.hairline {
		margin-bottom: 10px;
	}
	.list {
		margin-top: 14px;
	}

	.year {
		margin-bottom: 18px;
	}
	.year-label {
		margin: 22px 0 6px;
		font-size: 11.5px;
		letter-spacing: 0.14em;
	}

	.rows {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
</style>
