# Umami analytics. Leave both empty (or unset) to render no tracking script.
# Set them in the environment of the build (host dashboard or CI), because the
# values are inlined into the HTML at build time.
UMAMI_SCRIPT_URL=https://stats.example.com/script.js
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
